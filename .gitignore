# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/*.xcworkspace/

*.xcodeproj/*.xcworkspace/*
!*.xcodeproj/*.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/*.xcworkspace/xcshareddata/

*.xcodeproj/*.xcworkspace/xcshareddata/*
!*.xcodeproj/*.xcworkspace/xcshareddata/swiftpm/

# Other
.DS_Store

# Zed
.zed

# Xcode-Build-Server
buildServer.json

# TachiAZ JVM runtime artifacts
/Runtime/ExtensionHost/build/
/Runtime/ExtensionHost/dist/*
!/Runtime/ExtensionHost/dist/tachiaz-extension-host.jar
/Runtime/ExtensionHost/compat/*
!/Runtime/ExtensionHost/compat/README.md
/Runtime/MobileShims/build/
/Runtime/MobileShims/dist/*
!/Runtime/MobileShims/dist/tachiaz-mobile-shims.jar
!/Runtime/MobileShims/dist/cacerts
/Vendor/OpenJDK/*
!/Vendor/OpenJDK/README.md
